{
  "cli": { "version": ">= 13.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.20.0",
      "android": { "buildType": "apk" },
      "environment": "preview"
    },
    "production": {
      "node": "20.20.0",
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "environment": "production"
    },
    "production-verify": {
      "node": "20.20.0",
      "distribution": "store",
      "android": { "buildType": "apk" },
      "environment": "production"
    }
  },
  "submit": { "production": {} }
}
