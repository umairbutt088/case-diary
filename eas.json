{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.20.0",
      "android": { "buildType": "apk" },
      "environment": "preview"
    },
    "production": {
      "node": "20.20.0",
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "environment": "production"
    },
    "production-verify": {
      "node": "20.20.0",
      "distribution": "store",
      "android": { "buildType": "apk" },
      "environment": "production"
    },
    "production-ios-preview": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US"
      }
    }
  }
}
