{
  "expo": {
    "name": "legal-diary",
    "slug": "legal-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "legaldiary",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usamabutt.legal-diary",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Legal Diary uses your photo library to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.umairbutt.legaldiary"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/legal-diary-image5.png",
          "resizeMode": "cover",
          "imageWidth": 300,
          "imageHeight": 300,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Legal Diary uses your photos to set your profile picture.",
          "cameraPermission": "Legal Diary uses the camera to take your profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d913b2c-450d-48f9-a614-94ac21ba45b1"
      }
    }
  }
}
